{
  "name": "havre-de-paix-gestion",
  "version": "1.0.0",
  "description": "Application de gestion (stock, dépenses, dettes clients) pour Havre de Paix",
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/copy-vendor.js",
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "chart.js": "4.5.1",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "node-sqlite3-wasm": "0.8.60"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.havredepaix.gestion",
    "productName": "Havre de Paix - Gestion",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "db/**/*",
      "export/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Havre-de-Paix-Gestion-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MiralAmana",
        "repo": "Havre-de-Paix-Gestion",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MiralAmana/Havre-de-Paix-Gestion.git"
  }
}
